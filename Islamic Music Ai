<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Islamic Music AI - Offline & Editor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.css">
    <!-- Audio Tag Editor Library -->
    <script src="https://cdn.jsdelivr.net/npm/browser-id3-writer@4.4.0/build/browser-id3-writer.min.js"></script>
</head>
<body class="bg-slate-900 text-slate-200 min-h-screen pb-20 font-sans">

    <!-- Header -->
    <header class="p-4 bg-slate-800/50 sticky top-0 z-50 flex justify-between items-center shadow-lg border-b border-slate-700">
        <h1 class="text-xl font-bold text-yellow-500"><i class="fas fa-mosque mr-2"></i>Islamic Music AI</h1>
        <span class="text-xs bg-green-600/20 text-green-400 px-2 py-1 rounded border border-green-600/50" id="network-status">Online</span>
    </header>

    <main class="p-4 max-w-lg mx-auto">
        
        <!-- Create Section -->
        <section id="create-view" class="space-y-4">
            <div class="bg-slate-800 p-5 rounded-2xl shadow-xl border border-slate-700">
                <h2 class="text-lg font-bold text-yellow-500 border-b border-slate-600 pb-2 mb-4">নতুন অডিও তৈরি করুন</h2>
                
                <input type="text" id="audio-title" class="w-full bg-slate-900 border border-slate-600 p-3 rounded-lg outline-none focus:border-yellow-500 mb-3" placeholder="টাইটেল (যেমন: সূরা ফাতিহা)">
                
                <select id="category" class="w-full bg-slate-900 border border-slate-600 p-3 rounded-lg outline-none mb-3" onchange="updateVoices()">
                    <option value="tilawat">কুরআন তিলাওয়াত</option>
                    <option value="ghazal">গজল / হামদ / নাত</option>
                </select>

                <select id="voice-select" class="w-full bg-slate-900 border border-slate-600 p-3 rounded-lg outline-none mb-3">
                    <!-- Options populated by JS -->
                </select>

                <textarea id="lyrics-text" rows="4" class="w-full bg-slate-900 border border-slate-600 p-3 rounded-lg outline-none focus:border-yellow-500 mb-3" placeholder="লিরিক্স বা আয়াত এখানে লিখুন..."></textarea>

                <button onclick="generateAndSaveAudio()" id="generate-btn" class="w-full bg-yellow-500 text-slate-900 font-bold py-3 rounded-lg hover:bg-yellow-400 transition">
                    <i class="fas fa-magic mr-1"></i> অডিও তৈরি করুন (Online)
                </button>
            </div>
        </section>

        <!-- Library Section -->
        <section id="library-view" class="hidden space-y-4">
            <h2 class="text-lg font-bold text-yellow-500 mb-2">আপনার লাইব্রেরি (Offline)</h2>
            <div id="offline-tracks" class="space-y-3">
                <!-- Tracks will load here -->
            </div>
        </section>

        <!-- Tag Editor Modal -->
        <div id="editor-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
            <div class="bg-slate-800 p-6 rounded-2xl w-full max-w-sm border border-slate-600">
                <h3 class="text-yellow-500 font-bold text-lg mb-4">অডিও ইনফরমেশন এডিট</h3>
                <input type="hidden" id="edit-id">
                <label class="text-xs text-slate-400">নতুন টাইটেল</label>
                <input type="text" id="edit-title" class="w-full bg-slate-900 border border-slate-600 p-2 rounded mb-3">
                
                <label class="text-xs text-slate-400">আর্টিস্ট / কারীর নাম</label>
                <input type="text" id="edit-artist" class="w-full bg-slate-900 border border-slate-600 p-2 rounded mb-4">
                
                <div class="flex justify-between gap-3">
                    <button onclick="closeEditor()" class="flex-1 bg-slate-600 text-white py-2 rounded">বাতিল</button>
                    <button onclick="saveEditedTags()" class="flex-1 bg-yellow-500 text-slate-900 font-bold py-2 rounded">সেভ করুন</button>
                </div>
            </div>
        </div>

    </main>

    <!-- Bottom Nav -->
    <nav class="fixed bottom-0 left-0 right-0 bg-slate-800 p-3 flex justify-around border-t border-slate-700">
        <button onclick="switchTab('create')" class="text-yellow-500 flex flex-col items-center"><i class="fas fa-plus-circle text-xl"></i><span class="text-xs mt-1">তৈরি করুন</span></button>
        <button onclick="switchTab('library')" class="text-slate-400 flex flex-col items-center"><i class="fas fa-folder-open text-xl"></i><span class="text-xs mt-1">লাইব্রেরি</span></button>
    </nav>

    <script>
        const API_KEY = "AIzaSyAT5laYvGp8Tq9QWe1gCeASJ51mOxrmhRM";
        let db;

        // Qari & Voice Lists
        const qaris = [
            "শায়খ আব্দুল বাসিত আব্দুল সামাদ", "শায়খ আব্দুর রহমান আল-সুদাইস", "শায়খ মিশারি রশিদ আল-আফাসি",
            "শায়খ মাহের আল-মুয়াইকলি", "শায়খ সাউদ আল-শুরাইম", "শায়খ আব্দুল্লাহ আল-জুহানি",
            "শায়খ ইয়াসির আদ-দুসারি", "শায়খ বান্দার বালিলা", "শায়খ খলিল আল-হুসারি", "শায়খ মিনশাউই"
        ];
        const normalVoices = ["ছেলে (শান্ত)", "মেয়ে (আবেগীয়)", "ছেলে-মেয়ে দ্বৈত", "কাস্টম কণ্ঠ"];

        // 1. Initialize IndexedDB
        const request = indexedDB.open("IslamicMusicDB", 1);
        request.onupgradeneeded = (e) => {
            db = e.target.result;
            db.createObjectStore("tracks", { keyPath: "id", autoIncrement: true });
        };
        request.onsuccess = (e) => { db = e.target.result; loadOfflineTracks(); };

        // 2. Setup UI Logic
        function updateVoices() {
            const cat = document.getElementById("category").value;
            const select = document.getElementById("voice-select");
            select.innerHTML = "";
            const list = cat === 'tilawat' ? qaris : normalVoices;
            list.forEach(v => {
                select.innerHTML += `<option value="${v}">${v}</option>`;
            });
        }
        updateVoices();

        function switchTab(tab) {
            document.getElementById('create-view').classList.toggle('hidden', tab !== 'create');
            document.getElementById('library-view').classList.toggle('hidden', tab !== 'library');
            if(tab === 'library') loadOfflineTracks();
        }

        // 3. Network Connection Check
        window.addEventListener('online', () => document.getElementById('network-status').innerText = "Online");
        window.addEventListener('offline', () => document.getElementById('network-status').innerText = "Offline");

        // 4. Generate Music (Requires Network)
        async function generateAndSaveAudio() {
            if (!navigator.onLine) return alert("অডিও তৈরি করতে ইন্টারনেট সংযোগ প্রয়োজন!");
            
            const title = document.getElementById("audio-title").value;
            const artist = document.getElementById("voice-select").value;
            
            if(!title) return alert("টাইটেল লিখুন!");

            const btn = document.getElementById('generate-btn');
            btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i> তৈরি হচ্ছে...`;
            
            try {
                // Here we simulate the API call to your AI model. 
                // In a real app, you send the prompt and API_KEY, and receive an audio file URL or Blob.
                // For demonstration, we fetch a sample public domain Islamic audio blob.
                const response = await fetch("https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3");
                const audioBlob = await response.blob();

                // Save to IndexedDB for Offline use
                const transaction = db.transaction(["tracks"], "readwrite");
                const store = transaction.objectStore("tracks");
                store.add({
                    title: title,
                    artist: artist,
                    blob: audioBlob,
                    date: new Date().toLocaleDateString()
                });

                alert("অспеলভাবে তৈরি এবং সেভ হয়েছে! লাইব্রেরিতে গিয়ে অফলাইনে শুনতে পারবেন।");
                document.getElementById("audio-title").value = "";
            } catch (err) {
                alert("API Error: " + err.message);
            }
            btn.innerHTML = `<i class="fas fa-magic mr-1"></i> অডিও তৈরি করুন (Online)`;
        }

        // 5. Load Offline Tracks
        function loadOfflineTracks() {
            const container = document.getElementById("offline-tracks");
            container.innerHTML = "";
            
            if(!db) return;
            const transaction = db.transaction(["tracks"], "readonly");
            const store = transaction.objectStore("tracks");
            
            store.openCursor().onsuccess = (e) => {
                const cursor = e.target.result;
                if (cursor) {
                    const track = cursor.value;
                    const url = URL.createObjectURL(track.blob);
                    
                    container.innerHTML += `
                        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 relative">
                            <h3 class="font-bold text-yellow-500">${track.title}</h3>
                            <p class="text-xs text-slate-400 mb-2">কণ্ঠ: ${track.artist} | তারিখ: ${track.date}</p>
                            <audio controls class="w-full h-10 outline-none" src="${url}"></audio>
                            
                            <div class="mt-3 flex gap-2">
                                <button onclick="openEditor(${track.id}, '${track.title}', '${track.artist}')" class="bg-blue-600/20 text-blue-400 text-xs px-3 py-1 rounded hover:bg-blue-600/40 border border-blue-600/50">
                                    <i class="fas fa-edit"></i> এডিট ট্যাগ
                                </button>
                                <a href="${url}" download="${track.title}.mp3" class="bg-green-600/20 text-green-400 text-xs px-3 py-1 rounded hover:bg-green-600/40 border border-green-600/50">
                                    <i class="fas fa-download"></i> সেভ MP3
                                </a>
                            </div>
                        </div>
                    `;
                    cursor.continue();
                }
            };
        }

        // 6. Offline ID3 Tag Editor Logic
        function openEditor(id, currentTitle, currentArtist) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-title').value = currentTitle;
            document.getElementById('edit-artist').value = currentArtist;
            document.getElementById('editor-modal').classList.remove('hidden');
        }

        function closeEditor() {
            document.getElementById('editor-modal').classList.add('hidden');
        }

        function saveEditedTags() {
            const id = Number(document.getElementById('edit-id').value);
            const newTitle = document.getElementById('edit-title').value;
            const newArtist = document.getElementById('edit-artist').value;

            const transaction = db.transaction(["tracks"], "readwrite");
            const store = transaction.objectStore("tracks");
            
            store.get(id).onsuccess = async (e) => {
                const track = e.target.result;
                
                // Read the blob as ArrayBuffer to inject ID3 tags
                const arrayBuffer = await track.blob.arrayBuffer();
                
                // Use browser-id3-writer
                const writer = new browserID3Writer(arrayBuffer);
                writer.setFrame('TIT2', newTitle)
                      .setFrame('TPE1', [newArtist])
                      .setFrame('TALB', 'Islamic Music AI - Md.Biplob')
                      .setFrame('TCOM', ['Waz Mahfil Media']);
                writer.addTag();

                // Convert back to Blob
                const taggedBlob = writer.getBlob();
                
                // Update Database
                track.title = newTitle;
                track.artist = newArtist;
                track.blob = taggedBlob;
                
                store.put(track).onsuccess = () => {
                    closeEditor();
                    loadOfflineTracks();
                    alert("অফলাইনে ট্যাগ সফলভাবে আপডেট হয়েছে!");
                };
            };
        }
    </script>
</body>
</html>
